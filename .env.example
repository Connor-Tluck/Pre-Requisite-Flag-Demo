# =============================================================================
#  LaunchDarkly Orchestration Demo — Environment Variables
# =============================================================================
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# =============================================================================

# LaunchDarkly REST API access token (starts with api-)
# Used by: setup script, server live mode (bidirectional sync)
# Create one at: https://app.launchdarkly.com/settings/authorization
LD_API_KEY=

# LaunchDarkly project key
# Find it at: https://app.launchdarkly.com → Project settings
LD_PROJECT_KEY=default

# LaunchDarkly environment key
LD_ENVIRONMENT_KEY=production

# LaunchDarkly server-side SDK key (starts with sdk-)
# Used by: server.js for flag evaluation via streaming
# Find it at: Project settings → Environments → SDK key
# Leave empty to run in simulation mode (no LD account needed)
LD_SDK_KEY=

# LaunchDarkly client-side ID
# Used by: shop page browser SDK (observability, session replay)
# Find it at: Project settings → Environments → Client-side ID
LD_CLIENT_SIDE_ID=

# Port for the Express server
PORT=3000
